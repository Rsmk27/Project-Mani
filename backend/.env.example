OPENROUTER_API_KEY=your_openrouter_api_key_here
# Can be a single model, "openrouter/auto", or a comma-separated list of fastest fallback models
OPENROUTER_MODEL=google/gemini-2.0-flash-001,meta-llama/llama-3.3-70b-instruct,meta-llama/llama-3.1-8b-instruct
# Prioritize throughput or latency (throughput = max tokens/sec, latency = fastest time-to-first-token)
OPENROUTER_PROVIDER_SORT=throughput
PORT=3001
